# Node dependencies
node_modules/
dist/
.DS_Store

# Sanity local cache and configurations
studio/node_modules/
studio/dist/
studio/.sanity/
studio/.env
studio/.env.*
studio/package-lock.json

# Raw client photo drops (originals live outside the build)
28-07-26/
# WhatsApp album drops — extract, optimise into assets/img/photos/, then
# leave the archive out of the repo.
WhatsApp*.zip

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Video masters. Only the compressed clips in assets/video/ are deployed —
# the .src.mp4 originals are 5-7 MB each and are kept locally for re-encodes.
assets/img/*.src.mp4

# Stray root-level copy of the Sanity Studio bundle. A previous build step
# duplicated admin/static/ to the repo root; nothing references it.
# MUST stay anchored with a leading slash: a bare "static/" also matches
# admin/static/, which is the studio's own deployed bundle. Un-anchoring this
# silently strips the studio's JavaScript from the deploy and the CMS goes blank.
/static/
